# Security headers (Apache / Hostinger)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|gif|ico|svg|woff2|woff|webmanifest)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html

# Avoid content-negotiation picking wrong handlers for missing URLs (LiteSpeed/Apache)
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Custom 404 — file must live in site root (public_html/404.html)
# hPanel backup: Websites → Manage → Advanced → Error pages → 404 → /404.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Plain .html page URLs only (no /contact, /about, or other rewrites).

  # Force HTTPS on production host (optional — enable when SSL is active)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?riverbird\.in$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # LiteSpeed/Hostinger fallback when ErrorDocument is overridden in hPanel
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ /404.html [L,R=404]
</IfModule>
