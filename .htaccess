# Security headers (Apache / Hostinger)
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header set X-XSS-Protection "1; mode=block"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  <FilesMatch "\.(css|js|png|jpg|jpeg|webp|gif|ico|svg|woff2|woff|webmanifest)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

DirectoryIndex index.html

# Avoid content-negotiation picking wrong handlers for missing URLs (LiteSpeed/Apache)
<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Custom 404 — file must live in site root (public_html/404.html)
# hPanel backup: Websites → Manage → Advanced → Error pages → 404 → /404.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical clean URLs. The THE_REQUEST check prevents internal rewrites from
  # triggering these redirects again.
  RewriteCond %{THE_REQUEST} \s/+index\.html[?\ ] [NC]
  RewriteRule ^index\.html$ /home [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+about\.html[?\ ] [NC]
  RewriteRule ^about\.html$ /aboutus [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+blog_index\.html[?\ ] [NC]
  RewriteRule ^blog_index\.html$ /blog [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+development_index\.html[?\ ] [NC]
  RewriteRule ^development_index\.html$ /development-solution [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+software\.html[?\ ] [NC]
  RewriteRule ^software\.html$ /best-software-solution [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+web\.html[?\ ] [NC]
  RewriteRule ^web\.html$ /best-web-development [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+app\.html[?\ ] [NC]
  RewriteRule ^app\.html$ /best-application-development [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+digital_marketing_index\.html[?\ ] [NC]
  RewriteRule ^digital_marketing_index\.html$ /best-digital-marketing [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+social-media\.html[?\ ] [NC]
  RewriteRule ^social-media\.html$ /social-media-marketing [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+personal-branding\.html[?\ ] [NC]
  RewriteRule ^personal-branding\.html$ /personal-branding [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+influencer-marketing\.html[?\ ] [NC]
  RewriteRule ^influencer-marketing\.html$ /influencer-marketing [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+seo\.html[?\ ] [NC]
  RewriteRule ^seo\.html$ /search-engine-optimization [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+lead-generation\.html[?\ ] [NC]
  RewriteRule ^lead-generation\.html$ /lead-generation [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+paid-ads\.html[?\ ] [NC]
  RewriteRule ^paid-ads\.html$ /google-and-meta-ads [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+video-production\.html[?\ ] [NC]
  RewriteRule ^video-production\.html$ /video-production-services [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+graphic-design\.html[?\ ] [NC]
  RewriteRule ^graphic-design\.html$ /graphic-design-services [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+brand-identity\.html[?\ ] [NC]
  RewriteRule ^brand-identity\.html$ /branding-services [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+staffing_index\.html[?\ ] [NC]
  RewriteRule ^staffing_index\.html$ /staffing-solutions [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+talent-management\.html[?\ ] [NC]
  RewriteRule ^talent-management\.html$ /talent-management [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+hire-talent\.html[?\ ] [NC]
  RewriteRule ^hire-talent\.html$ /hire-talent [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+manpower\.html[?\ ] [NC]
  RewriteRule ^manpower\.html$ /hr-services [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+product_index\.html[?\ ] [NC]
  RewriteRule ^product_index\.html$ /products [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+careers_index\.html[?\ ] [NC]
  RewriteRule ^careers_index\.html$ /careers [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+contact_index\.html[?\ ] [NC]
  RewriteRule ^contact_index\.html$ /contact [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+privacy_policy\.html[?\ ] [NC]
  RewriteRule ^privacy_policy\.html$ /privacy-policy [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+terms_of_service\.html[?\ ] [NC]
  RewriteRule ^terms_of_service\.html$ /terms-of-service [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+refund_and_cancellation\.html[?\ ] [NC]
  RewriteRule ^refund_and_cancellation\.html$ /refund-policy [R=301,L,NE]

  # Serve the existing static files for canonical URLs without changing the URL.
  RewriteRule ^home/?$ index.html [L]
  RewriteRule ^aboutus/?$ about.html [L]
  RewriteRule ^blog/?$ blog_index.html [L]
  RewriteRule ^development-solution/?$ development_index.html [L]
  RewriteRule ^best-software-solution/?$ software.html [L]
  RewriteRule ^best-web-development/?$ web.html [L]
  RewriteRule ^best-application-development/?$ app.html [L]
  RewriteRule ^best-digital-marketing/?$ digital_marketing_index.html [L]
  RewriteRule ^social-media-marketing/?$ social-media.html [L]
  RewriteRule ^personal-branding/?$ personal-branding.html [L]
  RewriteRule ^influencer-marketing/?$ influencer-marketing.html [L]
  RewriteRule ^search-engine-optimization/?$ seo.html [L]
  RewriteRule ^lead-generation/?$ lead-generation.html [L]
  RewriteRule ^google-and-meta-ads/?$ paid-ads.html [L]
  RewriteRule ^video-production-services/?$ video-production.html [L]
  RewriteRule ^graphic-design-services/?$ graphic-design.html [L]
  RewriteRule ^branding-services/?$ brand-identity.html [L]
  RewriteRule ^staffing-solutions/?$ staffing_index.html [L]
  RewriteRule ^talent-management/?$ talent-management.html [L]
  RewriteRule ^hire-talent/?$ hire-talent.html [L]
  RewriteRule ^hr-services/?$ manpower.html [L]
  RewriteRule ^products/?$ product_index.html [L]
  RewriteRule ^careers/?$ careers_index.html [L]
  RewriteRule ^contact/?$ contact_index.html [L]
  RewriteRule ^privacy-policy/?$ privacy_policy.html [L]
  RewriteRule ^terms-of-service/?$ terms_of_service.html [L]
  RewriteRule ^refund-policy/?$ refund_and_cancellation.html [L]

  # Force HTTPS on production host (optional — enable when SSL is active)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?riverbird\.in$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # LiteSpeed/Hostinger fallback when ErrorDocument is overridden in hPanel
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/404\.html$ [NC]
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^ /404.html [L,R=404]
</IfModule>
